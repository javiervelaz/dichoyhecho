# Copiar a .env en el VPS. Nunca commitear .env (repo público).

# Base de datos (Neon, proyecto dichoyhecho). Usar el endpoint con pooler para la app.
DATABASE_URL=postgres://USER:PASSWORD@HOST/dichoyhecho?sslmode=require

# Autenticación de webhooks entre n8n y los servicios
SERVICE_TOKEN=cambiar-por-un-token-largo-aleatorio

# Topes de gasto mensual en USD (obligatorios: sin ellos el worker no arranca)
LLM_MONTHLY_CAP_USD=40
TTS_MONTHLY_CAP_USD=25
STT_MONTHLY_CAP_USD=15

# Anthropic
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-5-5
MODEL_ANALYSIS=claude-sonnet-5-5

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dichoyhecho-media

# YouTube Data API (lectura pública) y OAuth (subidas)
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# TikTok y Meta (Etapa 0, sprint 5)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Telegram (resumen diario y alertas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
